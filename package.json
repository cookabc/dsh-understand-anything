{
  "name": "dsh-understand-anything",
  "version": "0.2.0",
  "description": "Codebase knowledge graphs for DSH: deterministic scanning, impact-aware queries, guided tours and an offline dashboard.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "bin",
    "skills",
    "scripts/market-index.mjs",
    "README.md",
    "README.zh.md",
    "docs/PUBLISHING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --test test/*.test.mjs && npm pack --dry-run",
    "release-gate": "node scripts/release-gate.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "knowledge-graph",
    "codebase-analysis",
    "architecture",
    "onboarding",
    "understand-anything"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cookabc/dsh-understand-anything.git",
    "directory": ""
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
